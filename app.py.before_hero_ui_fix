    palette = {
        "Action": ("#e45c43", "#272341", "#f6c76e"),
        "Romance": ("#d98d8f", "#254c59", "#f8e7c8"),
        "Comedy": ("#f0b74d", "#b94f39", "#f9e7b3"),
        "Drama": ("#49758a", "#162b49", "#eac27a"),
