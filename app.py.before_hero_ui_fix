        collection_label = "POWER STAR COLLECTION"
    else:
        centerpiece = f'''<circle cx="200" cy="205" r="86" fill="{accent}" opacity=".12"/>
<circle cx="200" cy="205" r="67" fill="none" stroke="{accent}" stroke-width="1.5" opacity=".75"/>
