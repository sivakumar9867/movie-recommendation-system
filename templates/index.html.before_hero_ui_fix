<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#153c3c">
  <meta name="description" content="A Telugu cinema club for discovering films, favourites and your next watch.">
  <title>Mana Cinema — Stories from home</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Noto+Sans+Telugu:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
  <script>
    // Capture image errors from the start of parsing, before any card image can fail.
    document.addEventListener('error', event => {
      const img = event.target;
      if (!(img instanceof HTMLImageElement)) return;
      const alternate = (img.dataset.alternate || '').trim();
      if (alternate && img.dataset.alternateTried !== 'yes') {
        img.dataset.alternateTried = 'yes';
        img.src = alternate;
        return;
      }
      const movieCard = img.closest('.catalog-card, .result-card');
      if (movieCard) movieCard.remove();
    }, true);
  </script>
</head>
<body>
{% macro poster(movie, classes='') -%}
  <div class="poster-frame {{ classes }}">
    <img class="poster-image" src="{{ movie.poster_url or movie.poster_alt_url }}"
         data-alternate="{{ movie.poster_alt_url if movie.poster_url else '' }}"
         alt="Original poster for {{ movie.title }}" loading="lazy"
         onerror="if(this.dataset.alternate){const next=this.dataset.alternate;this.dataset.alternate='';this.src=next;}else{const card=this.closest('.catalog-card,.result-card,.hero-poster,.starting-poster');if(card)card.hidden=true;this.closest('.poster-frame')?.classList.add('poster-unavailable');document.dispatchEvent(new Event('mana:poster-failed'));}">
    <span class="poster-grain" aria-hidden="true"></span>
  </div>
{%- endmacro %}
<header class="site-header">
  <a class="brand" href="{{ url_for('index') }}" aria-label="Mana Cinema home">
    <span class="brand-seal">మ</span>
    <span class="brand-name">MANA <b>CINEMA</b><small>THE TELUGU FILM CLUB</small></span>
  </a>
  <nav class="main-nav" aria-label="Main navigation">
    <a href="#power-star">Fan shelf</a><a href="#explore-heroes">By hero</a><a href="#collection">The collection</a><a href="#discover">Find a film</a>
  </nav>
  <a class="header-button" href="#discover">Pick tonight's film <span>↗</span></a>
</header>
<div class="ticker" aria-label="Mana Cinema tagline"><div class="ticker-track"><span>మన సినిమా</span><i>✳</i><span>STORIES FROM HOME</span><i>✳</i><span>ONE MORE SHOW</span><i>✳</i><span>మన సినిమా</span><i>✳</i><span>STORIES FROM HOME</span><i>✳</i><span>ONE MORE SHOW</span></div></div>
<main>
  <section class="hero" id="top">
    <div class="hero-copy">
      <p class="kicker"><span class="kicker-dot"></span> A LITTLE TELUGU CINEMA, A LOT OF FEELING</p>
      <h1>Stories that<br>feel like <em>home.</em></h1>
      <p class="hero-text">From first-love classics to full-volume mass moments, find a Telugu film that fits your mood — and discover the next one.</p>
      <div class="hero-actions"><a class="btn btn-red" href="#discover">Find my next film <span>↗</span></a><a class="under-link" href="#collection">Browse the shelves <span>↓</span></a></div>
      <div class="hero-signoff"><span class="signoff-rule"></span><span>Made for people who love Telugu stories.</span></div>
      <span class="hero-stamp">EST. FOR<br>THE LOVE<br>OF CINEMA</span>
    </div>
    <div class="hero-stage">
      <div class="stage-paper stage-paper-one"></div><div class="stage-paper stage-paper-two"></div>
      <div class="stage-label"><span>FEATURED CHAPTER</span><b>THREE STARS · ONE SCREEN</b></div>
      <div class="hero-poster hero-poster-back">{{ poster(stage_movies.ram_charan, 'poster-ram-charan') if stage_movies.ram_charan else '' }}</div>
      <div class="hero-poster hero-poster-mid">{{ poster(stage_movies.prabhas, 'poster-prabhas') if stage_movies.prabhas else '' }}</div>
      <div class="hero-poster hero-poster-front">{{ poster(stage_movies.pawan_kalyan, 'poster-pawan') if stage_movies.pawan_kalyan else '' }}</div>
      <div class="stage-caption"><strong>RAM CHARAN · PAWAN KALYAN · PRABHAS</strong><span>THREE FAVOURITES OF TELUGU CINEMA</span></div>
      <div class="stage-orbit orbit-one"></div><div class="stage-orbit orbit-two"></div>
    </div>
  </section>

  <section class="numbers-bar" aria-label="Catalogue summary">
    <div><b>{{ movie_count }}</b><span>films in the collection</span></div>
    <div><b>{{ genres|length }}</b><span>genres to explore</span></div>
    <div><b>{{ power_star_movies|length }}</b><span>Pawan Kalyan favourites</span></div>
    <p>Pick a mood. Find a story. Press play.</p>
  </section>

  <section class="power-section" id="power-star">
    <div class="power-intro">
      <div><p class="kicker kicker-light">THE FAN'S CUT · NO. 01</p><h2>Power Star<br><em>on the big screen.</em></h2><p>A dedicated shelf for Pawan Kalyan films — from the romance of <i>Tholi Prema</i> to the swagger of <i>Gabbar Singh</i>.</p></div>
      <div class="power-seal"><span>PAWAN</span><b>PK</b><span>KALYAN</span><small>FAN'S SHELF</small></div>
    </div>
    <div class="power-cards">
      {% for movie in power_star_movies %}
      <form class="power-card" method="post" action="{{ url_for('index') }}#results">
        <input type="hidden" name="movie" value="{{ movie.title }}">
        <button type="submit" class="poster-button" aria-label="Find films like {{ movie.title }}">
          {{ poster(movie) }}
          <span class="power-card-meta"><small>{{ movie.year }} · {{ movie.genres|join(' · ') }}</small><strong>{{ movie.title }}</strong><i>EXPLORE FILMS ↗</i></span>
        </button>
      </form>
      {% endfor %}
    </div>
  </section>

  <section class="hero-explore-section" id="explore-heroes">
    <div class="hero-explore-heading"><div><p class="kicker">THE STARS OF TELUGU CINEMA</p><h2>Explore by <em>hero.</em></h2><p>Choose an actor to see the films led by them in our collection.</p></div><span class="hero-explore-mark">నటుడు<br><b>✳</b></span></div>
    <div class="hero-chip-list" role="group" aria-label="Filter films by lead actor">
      <button type="button" class="hero-chip is-active" data-hero-filter="all">All heroes</button>
      {% for hero in heroes %}<button type="button" class="hero-chip" data-hero-filter="{{ hero|lower }}">{{ hero }}</button>{% endfor %}
    </div>
    <p class="hero-filter-note" id="hero-filter-note" aria-live="polite">Showing films from every hero. Select a name to narrow the collection.</p>
  </section>

  <section class="collection-section" id="collection">
    <div class="section-topline"><p class="kicker">THE MOVIE SHELF</p><span class="section-index">VOL. 01 / {{ movie_count }} TITLES</span></div>
    <div class="collection-heading"><div><h2>Find a film.<br><em>Find a feeling.</em></h2><p>Choose a title you love to discover stories with a similar spirit.</p></div><div class="collection-note"><span class="note-star">✳</span><span>THE COLLECTION<br>IS ALWAYS GROWING</span></div></div>
    <div class="catalog-tools">
      <label class="search-field"><span>⌕</span><input id="movie-search" type="search" placeholder="Search a title, actor or director…" autocomplete="off" aria-label="Search movies"><kbd>/</kbd></label>
      <div class="filter-tabs" role="group" aria-label="Filter the collection"><button type="button" class="filter-tab is-active" data-filter="all">All films</button><button type="button" class="filter-tab" data-filter="pawan">Pawan Kalyan</button></div>
      <span id="search-count" class="catalog-count">{{ movie_count }} FILMS</span>
    </div>
    <div class="catalog-grid" id="catalog-grid">
      {% for movie in movies %}
      <form class="catalog-card" method="post" action="{{ url_for('index') }}#results" data-title="{{ movie.title|lower }}" data-search="{{ (movie.title ~ ' ' ~ movie.director ~ ' ' ~ movie.cast ~ ' ' ~ movie.genres|join(' '))|lower }}" data-star="{{ 'pawan' if movie.star == 'Pawan Kalyan' else 'other' }}" data-hero="{{ movie.hero|lower }}">
        <input type="hidden" name="movie" value="{{ movie.title }}">
        <button type="submit" class="catalog-card-button" aria-label="Find recommendations for {{ movie.title }}">
          {{ poster(movie) }}
          {% if movie.star == 'Pawan Kalyan' %}<span class="fan-ribbon">POWER STAR PICK</span>{% endif %}
          <span class="catalog-meta"><span class="catalog-genre">{% if movie.year %}{{ movie.year }} · {% endif %}{{ movie.genres|join(' / ') }}</span><strong>{{ movie.title }}</strong><small>FIND SIMILAR <b>↗</b></small></span>
        </button>
      </form>
      {% endfor %}
    </div>
    <p class="no-results" id="no-results" hidden>No films found. Try a different search.</p>
  </section>

  <section class="discover-section" id="discover">
    <div class="discover-side"><p class="kicker kicker-light">YOUR NEXT WATCH</p><h2>What's the<br><em>mood today?</em></h2><p>Start with a favourite, choose a genre, or mix the two. We'll bring a shortlist to your screen.</p><div class="discover-steps"><span><b>01</b> Pick a film</span><span><b>02</b> Set your mood</span><span><b>03</b> Discover</span></div><span class="ticket-no">MANA · SCREEN 01 · ADMIT ONE</span></div>
    <div class="discover-form-wrap">
      <form method="post" action="{{ url_for('index') }}#results" id="recommend-form" class="discover-form">
        <div class="form-block"><div class="form-heading"><span>01</span><div><h3>Start with a movie</h3><p>Optional — pick something you enjoyed.</p></div></div><label for="movie-select" class="sr-only">Choose a movie</label><select id="movie-select" name="movie"><option value="">No movie — choose by genre</option>{% for title in movie_titles %}<option value="{{ title }}" {% if selected_movie == title %}selected{% endif %}>{{ title }}</option>{% endfor %}</select></div>
        <div class="form-block"><div class="form-heading"><span>02</span><div><h3>Choose your genres</h3><p>Pick one or more to match your mood.</p></div></div><div class="genre-grid">{% for genre in genres %}<label class="genre-chip"><input type="checkbox" name="genres" value="{{ genre }}" {% if genre in selected_genres %}checked{% endif %}><span>{{ genre }}</span></label>{% endfor %}</div></div>
        <div class="form-bottom"><p id="selected-summary" aria-live="polite">No preferences selected yet.</p><div><button class="btn btn-green" type="submit">Find my recommendations <span>↗</span></button><a href="{{ url_for('index') }}#discover" class="clear-link">Clear</a></div></div>
        {% if error %}<div class="form-error" role="alert">{{ error }}</div>{% endif %}
      </form>
    </div>
  </section>

  {% if request.method == 'POST' %}
  <section class="results-section" id="results">
    <div class="section-topline"><p class="kicker">YOUR PERSONAL SHORTLIST</p><span class="section-index">{{ recommendations|length }} MATCHES</span></div>
    <div class="results-heading"><h2>{% if selected_movie %}Because you liked <em>{{ selected_movie }}.</em>{% else %}A little more <em>your style.</em>{% endif %}</h2><p>{% if selected_genres %}YOUR GENRES · {{ selected_genres|join(' / ') }}{% else %}BASED ON YOUR SELECTED FILM{% endif %}</p></div>
    {% if selected_info %}<div class="starting-point"><div class="starting-poster">{{ poster(selected_info) }}</div><div><small>YOUR STARTING POINT</small><h3>{{ selected_info.title }}</h3><p>{{ selected_info.overview }}</p><span>{{ selected_info.genres|join(' · ') }}</span></div></div>{% endif %}
    {% if recommendations %}<div class="results-grid">{% for movie in recommendations %}<article class="result-card"><div class="result-art">{{ poster(movie) }}<span class="result-number">{{ '%02d'|format(loop.index) }}</span></div><div class="result-copy"><small class="result-genres">{{ movie.genres|join(' / ') }}</small><h3>{{ movie.title }}</h3><p class="result-director">A film by {{ movie.director }}</p><p class="result-overview">{{ movie.overview }}</p>{% if mode == 'genres' %}<span class="match-score">{{ (movie.genre_coverage * 100)|round|int }}% GENRE MATCH</span>{% else %}<span class="match-score">{{ (movie.similarity * 100)|round|int }}% CONTENT SIMILARITY</span>{% endif %}{% if movie.matched_genres %}<div class="match-tags">{% for genre in movie.matched_genres %}<span>{{ genre }}</span>{% endfor %}</div>{% endif %}</div></article>{% endfor %}</div>{% else %}<div class="empty-state"><span>✳</span><h3>No close matches this time.</h3><p>Try another title or combine a few genres for a wider search.</p></div>{% endif %}
  </section>
  {% endif %}

  <section class="how-section" id="how-it-works"><div><p class="kicker">BEHIND THE RECOMMENDATIONS</p><h2>Not random picks.<br><em>Thoughtful matches.</em></h2></div><div class="how-copy"><p>Mana Cinema builds a movie profile from genres, story, director and cast. TF-IDF turns those details into vectors; cosine similarity finds titles with overlapping features.</p><div class="method-tags"><span>TF-IDF</span><span>COSINE SIMILARITY</span><span>GENRE MATCHING</span></div><small>A student-built content-based recommendation project. The catalogue is curated, not exhaustive.</small></div></section>
</main>
<footer class="site-footer"><a class="brand footer-brand" href="#top"><span class="brand-seal">మ</span><span class="brand-name">MANA <b>CINEMA</b><small>THE TELUGU FILM CLUB</small></span></a><p>Made for the love of Telugu cinema.</p><small>Movie poster images remain the property of their respective rights holders. This fan-made student project is not affiliated with the film studios or actors.</small></footer>
<script>
(() => {
  const search = document.querySelector('#movie-search');
  const cards = [...document.querySelectorAll('.catalog-card')];
  const tabs = [...document.querySelectorAll('.filter-tab')];
  const heroTabs = [...document.querySelectorAll('.hero-chip')];
  const heroNote = document.querySelector('#hero-filter-note');
  let activeHero = 'all';
  const count = document.querySelector('#search-count');
  const empty = document.querySelector('#no-results');
  let activeFilter = 'all';
  function filterCatalog() {
    const query = (search?.value || '').trim().toLowerCase();
    let visible = 0;
    cards.forEach(card => {
      const matchesText = card.dataset.search.includes(query);
      const matchesFilter = activeFilter === 'all' || card.dataset.star === 'pawan';
      const matchesHero = activeHero === 'all' || card.dataset.hero === activeHero;
      card.hidden = !(matchesText && matchesFilter && matchesHero);
      if (!card.hidden) visible++;
    });
    if (count) count.textContent = `${visible} / ${cards.length} FILMS`;
    if (empty) empty.hidden = visible !== 0;
  }
  heroTabs.forEach(tab => tab.addEventListener('click', () => {
    activeHero = tab.dataset.heroFilter;
    activeFilter = 'all';
    tabs.forEach(item => item.classList.toggle('is-active', item.dataset.filter === 'all'));
    heroTabs.forEach(item => item.classList.toggle('is-active', item === tab));
    if (heroNote) heroNote.textContent = activeHero === 'all' ? 'Showing films from every hero. Select a name to narrow the collection.' : `Showing films led by ${tab.textContent.trim()}.`;
    filterCatalog();
    document.querySelector('#collection')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }));
  tabs.forEach(tab => tab.addEventListener('click', () => {
    activeFilter = tab.dataset.filter;
    tabs.forEach(item => item.classList.toggle('is-active', item === tab));
    filterCatalog();
  }));
  search?.addEventListener('input', filterCatalog);
  document.addEventListener('mana:poster-failed', () => { filterCatalog(); });
  document.addEventListener('keydown', event => {
    if (event.key === '/' && !['INPUT', 'TEXTAREA', 'SELECT'].includes(document.activeElement?.tagName)) {
      event.preventDefault(); search?.focus();
    }
    if (event.key === 'Escape' && document.activeElement === search) { search.value = ''; filterCatalog(); search.blur(); }
  });
  const genreInputs = [...document.querySelectorAll('.genre-chip input')];
  const movie = document.querySelector('#movie-select');
  const summary = document.querySelector('#selected-summary');
  function updateSummary() {
    if (!summary) return;
    const chosen = genreInputs.filter(input => input.checked).map(input => input.value);
    const parts = [];
    if (movie?.value) parts.push(movie.value);
    if (chosen.length) parts.push(`${chosen.length} genre${chosen.length === 1 ? '' : 's'}`);
    summary.textContent = parts.length ? `Selected · ${parts.join(' + ')}` : 'No preferences selected yet.';
  }
  genreInputs.forEach(input => input.addEventListener('change', updateSummary));
  movie?.addEventListener('change', updateSummary);
  updateSummary();
})();
</script>
</body>
</html>
